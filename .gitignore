# Allowlist: game files, toolchains, emulator SD and local IDE state stay local.
*
!/.gitignore
!/.gitattributes
!/README.md
!/HANDOFF.ru.md
!/porting/
!/porting/*.md
!/porting/requirements-tools.txt
!/porting/tools/
!/porting/tools/*.py
!/porting/tests/
!/porting/tests/*.py
!/porting/tests/*.c
!/porting/tests/*.cpp
!/porting/tests/*.s
!/porting/3ds/
!/porting/3ds/*.md
!/porting/3ds/*.rsf
!/porting/3ds/include/
!/porting/3ds/include/*.h
!/porting/3ds/source/
!/porting/3ds/source/*.c
!/porting/3ds/source/*.s
!/porting/3ds/build-emulator/
!/porting/3ds/build-emulator/build-manifest.json
!/porting/3ds/build-stage8/
!/porting/3ds/build-stage8/stage8.rsf
!/porting/3ds/build-stage8/icon.png
!/porting/3ds/build-stage8/stage8.bnr
!/porting/analysis/
!/porting/analysis/*.json
!/porting/analysis/stage2-*.c
!/porting/analysis/stage2-*.s
!/porting/analysis/hardware/
!/porting/analysis/hardware/*.json
!/porting/analysis/hardware/*.log
!/porting/analysis/android-abi/
!/porting/analysis/android-abi/*.json
!/porting/analysis/azahar-smoke/
!/porting/analysis/azahar-smoke/*-result.json
!/porting/analysis/azahar-smoke/result-*.json
!/porting/analysis/azahar-smoke/engine-*.log
!/porting/analysis/azahar-smoke/stage*-*.log
!/porting/analysis/engine-baseline/
!/porting/analysis/engine-baseline/*.json
!/porting/analysis/engine-baseline/*.log
!/porting/analysis/eaio-baseline/
!/porting/analysis/eaio-baseline/*.json
!/porting/analysis/eaio-baseline/*.log
!/porting/dist/
!/porting/dist/stage*/
!/porting/dist/stage*/*.json
!/porting/dist/stage*/*.md
