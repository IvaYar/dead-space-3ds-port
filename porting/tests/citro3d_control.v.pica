; Minimal untextured position/fixed-color shader; no DS34 shader linkage.
.fvec projection[4]
.constf identity_w(1.0, 1.0, 1.0, 1.0)
.out clip_position position
.out vertex_color color
.alias input_position v0
.alias input_color v1
.proc main
    mov r0.xyz, input_position
    mov r0.w, identity_w
    dp4 clip_position.x, projection[0], r0
    dp4 clip_position.y, projection[1], r0
    dp4 clip_position.z, projection[2], r0
    dp4 clip_position.w, projection[3], r0
    mov vertex_color, input_color
    end
.end
